---
// A hand-built replay of a Pipkin chat, drawn with the app's own layout, labels, icons and the page's theme, so it
// stays sharp at any size and weighs a few kilobytes instead of a video. Without JavaScript, or with reduced motion,
// it shows the finished chat.
import Icon, { type IconName } from "./Icon.astro";
import Logo from "./Logo.astro";

const prompt = "Add a dark mode toggle to my notes app and make sure the tests still pass";

interface Step {
  icon: IconName;
  name: string;
  detail: string;
  /** Lines added, shown at the end of the row as the app does. */
  added?: number;
  removed?: number;
}

// The fold is open, as if tapped, so every step shows on a rail under it as the app lists them.
const steps: Step[] = [
  { icon: "brain", name: "Thinking", detail: "Planning the change" },
  { icon: "terminal", name: "Shell", detail: "rg -l theme src" },
  { icon: "file_text", name: "Read", detail: "src/settings.tsx" },
  { icon: "file_pen", name: "Edit", detail: "src/theme.ts", added: 24, removed: 3 },
  { icon: "file_pen", name: "Edit", detail: "src/settings.tsx", added: 11, removed: 2 },
  { icon: "file_pen", name: "Write", detail: "src/settings.test.tsx", added: 18 },
  { icon: "terminal", name: "Shell", detail: "npm test" },
];

const reply =
  "Dark mode is in. The toggle lives in **Settings**, follows the system theme until you pick one, and saves your choice. All **18 tests** pass.";
const replyHtml = reply.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
---

<div
  class="phone"
  data-demo
  role="img"
  aria-label="Pipkin on an Android phone: the agent reads the code, edits files, writes a test, runs the tests, and reports back."
>
  <div class="screen" aria-hidden="true">
    <div class="status">
      <span>9:41</span>
      <span class="status-icons">
        <svg viewBox="0 0 16 12" width="16" height="12"><path d="M8 11.5 0.6 3.6a10.5 10.5 0 0 1 14.8 0z" fill="currentColor"></path></svg>
        <svg viewBox="0 0 12 12" width="12" height="12"><path d="M11.5 0.5v11h-11z" fill="currentColor"></path></svg>
        <svg viewBox="0 0 8 13" width="8" height="13"><rect x="0.5" y="1.5" width="7" height="11" rx="1.4" fill="currentColor"></rect><rect x="2.5" y="0" width="3" height="2" rx="0.6" fill="currentColor"></rect></svg>
      </span>
    </div>

    <div class="notification" data-part="notify">
      <div class="notification-icon"><Logo size={14} /></div>
      <div class="notification-body">
        <div class="notification-head">Pipkin · now</div>
        <div class="notification-title">Agent finished: Add a dark mode toggle</div>
        <div class="notification-text">Dark mode is in. All 18 tests pass.</div>
      </div>
    </div>

    <header class="appbar">
      <span class="appbar-mark"><Logo size={20} /></span>
      <div class="appbar-title">
        <span class="title-new">New chat</span>
        <span class="title-chat">Add a dark mode toggle</span>
        <span class="appbar-folder"><Icon name="folder" size={12} /> ~/notes-app</span>
      </div>
      <span class="round"><span class="tab-count">1</span></span>
      <span class="round"><Icon name="panel_right" size={18} /></span>
    </header>

    <div class="timeline">
      <div class="empty" data-part="empty">
        <span class="empty-mark"><Logo size={40} simmer /></span>
        <span>Message Pipkin to start</span>
      </div>

      <div class="step" data-part="sent">
        <div>
          <div class="prompt">
            <div class="prompt-head">
              <span class="you">You</span>
              <span class="prompt-time">· 9:41 AM</span>
              <Icon name="copy" size={13} />
            </div>
            <p class="prompt-text">{prompt}</p>
          </div>
        </div>
      </div>

      <div class="step" data-part="fold">
        <div>
          <div class="fold">
            <span class="fold-icon">
              <span class="while-working"><Logo size={14} simmer /></span>
              <span class="once-done"><Icon name="check" size={14} /></span>
            </span>
            <span class="fold-summary">
              <span class="fold-state"><span class="while-working">Working</span><span class="once-done">Done</span></span
              >{" · "}<span data-part="count">{steps.length} steps</span>
            </span>
            <Icon name="chevron_up" size={14} />
          </div>
          {
            steps.map((step) => (
              <div class="tool" data-part="tool">
                <div>
                  <div class="tool-row">
                    <Icon name={step.icon} size={14} />
                    <span class="tool-name">{step.name}</span>
                    <span class:list={["tool-detail", { summary: step.name === "Thinking" }]}>{step.detail}</span>
                    {(step.added !== undefined || step.removed !== undefined) && (
                      <span class="figure">
                        {step.added !== undefined && <span class="added">+{step.added}</span>}
                        {step.removed !== undefined && <span class="removed">−{step.removed}</span>}
                      </span>
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="step" data-part="reply">
        <div>
          <p class="reply" data-reply={reply} set:html={replyHtml} />
          <div class="reply-meta">
            <Icon name="copy" size={13} />
            <span>9:42 AM</span>
          </div>
        </div>
      </div>

      <div class="run">
        <span class="run-mark"><Logo size={14} simmer /></span>
        <span class="run-time" data-part="timer">1m 12s</span>
      </div>
    </div>

    <div class="composer">
      <div class="widget-strip" data-part="widget">
        <div>
          <div class="widget-tab">
            <Icon name="panel_top" size={12} />
            Todos
            <span class="dot"></span>
          </div>
        </div>
      </div>
      <div class="field">
        <span><span class="typed" data-part="typed"></span><span class="caret"></span><span class="placeholder"
            >Message Pipkin…</span
          ></span>
      </div>
      <div class="controls">
        <span class="chip round-chip"><Icon name="plus" size={16} /></span>
        <span class="chip">Claude Sonnet</span>
        <span class="chip"><Icon name="brain" size={13} /> Medium</span>
        <span class="spacer"></span>
        <svg class="context" viewBox="0 0 20 20" width="16" height="16">
          <circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="2" opacity="0.35"></circle>
          <circle
            class="context-used"
            cx="10"
            cy="10"
            r="8"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            pathLength="100"
            transform="rotate(-90 10 10)"></circle>
        </svg>
        <span class="send">
          <Icon name="arrow_up" size={15} class="send-arrow" />
          <Icon name="square" size={13} class="send-stop" />
        </span>
      </div>
      <div class="gesture"></div>
    </div>
  </div>
</div>
<script is:inline>
  // Runs before first paint, so the replay starts from an empty chat instead of flashing the finished one.
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.currentScript.previousElementSibling.classList.add("playing");
  }
</script>

<script>
  import { playDemo } from "../scripts/phone-demo";

  for (const phone of document.querySelectorAll<HTMLElement>("[data-demo]")) playDemo(phone);
</script>

<style>
  .phone {
    --frame: #0c0e0d;
    container-type: inline-size;
    position: relative;
    width: min(296px, 76vw);
    aspect-ratio: 1080 / 2280;
    padding: 9px;
    border-radius: 46px;
    background: var(--frame);
    box-shadow:
      0 0 0 1px #2a2f2d,
      0 40px 80px -30px rgb(0 0 0 / 0.55),
      0 18px 40px -20px rgb(0 0 0 / 0.4);
  }

  .screen {
    /* Sizes below are Pipkin's dp values, scaled to the mock's width as if the phone were 380dp wide. */
    --dp: calc(100cqi / 380);
    container-type: inline-size;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 38px;
    background: var(--page);
    color: var(--fg);
    font-family: var(--sans);
    font-size: calc(14.5 * var(--dp));
    line-height: 1.45;
    text-align: start;
    -webkit-user-select: none;
    user-select: none;
  }

  .screen :global(svg) {
    flex: none;
  }

  .status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: calc(14 * var(--dp)) calc(26 * var(--dp)) calc(4 * var(--dp));
    font-size: calc(13 * var(--dp));
    font-weight: 600;
  }

  .status-icons {
    display: flex;
    align-items: center;
    gap: calc(5 * var(--dp));
  }

  .status-icons svg {
    width: auto;
    height: calc(11 * var(--dp));
  }

  /* Header: the pot on a tile, the chat's title over its folder, then the tabs and panel buttons. */
  .appbar {
    display: flex;
    align-items: center;
    gap: calc(10 * var(--dp));
    padding: calc(10 * var(--dp)) calc(12 * var(--dp)) calc(8 * var(--dp));
  }

  .appbar-mark,
  .round {
    display: grid;
    flex: none;
    place-items: center;
    width: calc(36 * var(--dp));
    height: calc(36 * var(--dp));
    background: var(--surface-1);
  }

  .appbar-mark {
    border-radius: calc(12 * var(--dp));
  }

  .appbar-mark :global(svg) {
    width: calc(22 * var(--dp));
    height: calc(22 * var(--dp));
  }

  .round {
    border-radius: 50%;
  }

  .round :global(svg) {
    width: calc(18 * var(--dp));
    height: calc(18 * var(--dp));
  }

  .appbar-title {
    position: relative;
    display: grid;
    flex: 1;
    min-width: 0;
    line-height: 1.3;
  }

  .title-new,
  .title-chat {
    grid-area: 1 / 1;
    overflow: hidden;
    font-size: calc(17 * var(--dp));
    font-weight: 800;
    letter-spacing: -0.01em;
    white-space: nowrap;
    text-overflow: ellipsis;
    transition: opacity 0.35s ease;
  }

  .title-chat {
    opacity: 0;
  }

  .appbar-folder {
    display: flex;
    align-items: center;
    gap: calc(5 * var(--dp));
    color: var(--muted);
    font-size: calc(12 * var(--dp));
  }

  .appbar-folder :global(svg) {
    width: calc(12 * var(--dp));
    height: calc(12 * var(--dp));
  }

  .tab-count {
    display: grid;
    place-items: center;
    width: calc(16 * var(--dp));
    height: calc(16 * var(--dp));
    border: 1.5px solid currentColor;
    border-radius: calc(4 * var(--dp));
    font-size: calc(10 * var(--dp));
    font-weight: 700;
    line-height: 1;
  }

  .timeline {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 0;
    padding: 0 calc(14 * var(--dp)) calc(8 * var(--dp));
    overflow: hidden;
    mask-image: linear-gradient(to bottom, transparent, black calc(28 * var(--dp)));
  }

  .empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: calc(12 * var(--dp));
    color: var(--muted);
    font-weight: 600;
    transition:
      opacity 0.35s ease,
      transform 0.5s var(--ease-out);
  }

  /* The launcher's pot in the theme's accent on a wash of it, as the app's empty chat draws it. */
  .empty-mark {
    display: grid;
    place-items: center;
    width: calc(76 * var(--dp));
    height: calc(76 * var(--dp));
    border-radius: 50%;
    background: var(--accent-soft);
  }

  .empty-mark :global(svg) {
    width: calc(50 * var(--dp));
    height: calc(50 * var(--dp));
  }

  /* Steps grow from zero height, so the chat scrolls up smoothly as each one arrives. */
  .step {
    display: grid;
    grid-template-rows: 1fr;
    transition:
      grid-template-rows 0.45s var(--ease-out),
      opacity 0.4s ease;
  }

  /* The gap lives on the content, inside the clipped wrapper, so a collapsed step takes no space at all. */
  .step > div {
    min-height: 0;
    overflow: hidden;
  }

  .step > div > :first-child {
    margin-top: calc(10 * var(--dp));
  }

  .prompt {
    padding: calc(6 * var(--dp)) calc(14 * var(--dp)) calc(12 * var(--dp));
    border-radius: calc(18 * var(--dp));
    background: var(--surface-1);
  }

  .prompt-head {
    display: flex;
    align-items: center;
    gap: calc(4 * var(--dp));
    min-height: calc(26 * var(--dp));
    color: var(--muted);
    font-size: calc(10.5 * var(--dp));
    font-weight: 500;
  }

  .you {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .prompt-time {
    flex: 1;
  }

  .prompt-head :global(svg),
  .reply-meta :global(svg) {
    width: calc(13 * var(--dp));
    height: calc(13 * var(--dp));
  }

  .prompt-text {
    font-size: calc(14.5 * var(--dp));
  }

  /* A run of steps under one line that says Working, then Done. It's open, so its steps list under it. */
  .fold {
    display: flex;
    align-items: center;
    gap: calc(8 * var(--dp));
    min-height: calc(30 * var(--dp));
    padding: 0 calc(4 * var(--dp));
    font-size: calc(12.5 * var(--dp));
    white-space: nowrap;
  }

  .fold > :global(svg) {
    width: calc(14 * var(--dp));
    height: calc(14 * var(--dp));
    margin-left: auto;
    color: var(--muted);
  }

  .fold-icon {
    display: grid;
    width: calc(14 * var(--dp));
    height: calc(14 * var(--dp));
  }

  .fold-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .fold-icon .once-done {
    color: var(--success);
  }

  .fold-summary {
    color: var(--muted);
  }

  .fold-state {
    color: var(--fg);
    font-weight: 600;
  }

  /* The fold's icon and state say Working while the steps run, then Done. */
  .while-working,
  .working .once-done {
    display: none;
  }

  .working .while-working,
  .once-done {
    display: inline-flex;
  }

  /* Each step grows in under the last, as the app adds rows to an open fold. */
  .tool {
    display: grid;
    grid-template-rows: 1fr;
    transition:
      grid-template-rows 0.35s var(--ease-out),
      opacity 0.3s ease;
  }

  .tool > div {
    min-height: 0;
    overflow: hidden;
  }

  .tool-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: calc(8 * var(--dp));
    min-height: calc(30 * var(--dp));
    padding: 0 calc(4 * var(--dp));
    color: var(--muted);
    white-space: nowrap;
  }

  .tool-row > :global(svg) {
    width: calc(14 * var(--dp));
    height: calc(14 * var(--dp));
    transition: color 0.25s ease;
  }

  /* The rail that joins the steps through their icons, from the fold's line down to the newest step's icon. It stops
     short of each icon, as the app's foldRail does. */
  .tool-row::before,
  .tool-row::after {
    content: "";
    position: absolute;
    left: calc(10.25 * var(--dp));
    width: calc(1.5 * var(--dp));
    background: var(--border);
  }

  .tool-row::before {
    top: 0;
    height: calc(50% - 10 * var(--dp));
  }

  .tool-row::after {
    top: calc(50% + 10 * var(--dp));
    bottom: 0;
    display: none;
  }

  .phone:not(.playing) .tool:not(:last-child) .tool-row::after,
  .playing .tool:has(+ .tool.on) .tool-row::after {
    display: block;
  }

  /* The step running now, its icon in the accent as the app tints it. */
  .playing.working .tool.running .tool-row > :global(svg) {
    color: var(--accent);
  }

  .tool-name {
    color: var(--fg);
    font-size: calc(12.5 * var(--dp));
    font-weight: 600;
  }

  .tool-detail {
    flex: 1;
    overflow: hidden;
    font-family: var(--mono);
    font-size: calc(11.5 * var(--dp));
    text-overflow: ellipsis;
  }

  /* A thinking step's summary is prose; tools' paths and commands are code. */
  .tool-detail.summary {
    font-family: inherit;
    font-size: calc(12.5 * var(--dp));
  }

  .figure {
    display: flex;
    gap: 0.6ch;
    font-family: var(--mono);
    font-size: calc(11.5 * var(--dp));
  }

  .added {
    color: var(--success);
  }

  .removed {
    color: var(--danger);
  }

  .reply {
    font-size: calc(15 * var(--dp));
    line-height: 1.5;
  }

  .reply :global(strong) {
    font-weight: 700;
  }

  .reply-meta {
    display: flex;
    align-items: center;
    gap: calc(10 * var(--dp));
    padding: calc(6 * var(--dp)) calc(4 * var(--dp)) 0;
    color: var(--muted);
    font-size: calc(12.5 * var(--dp));
  }

  .run {
    display: flex;
    align-items: center;
    gap: calc(8 * var(--dp));
    min-height: calc(28 * var(--dp));
    padding: calc(4 * var(--dp)) calc(4 * var(--dp)) 0;
    color: var(--muted);
    font-size: calc(12 * var(--dp));
    font-variant-numeric: tabular-nums;
  }

  .run-mark {
    display: none;
  }

  .run-mark :global(svg) {
    width: calc(14 * var(--dp));
    height: calc(14 * var(--dp));
  }

  /* Composer: a raised sheet with the widget tabs, the field and its controls. */
  .composer {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0 calc(10 * var(--dp));
    border-radius: calc(22 * var(--dp)) calc(22 * var(--dp)) 0 0;
    background: var(--surface-1);
  }

  /* The tab strip unfolds above the field once a widget shows, growing the composer as the app does. */
  .widget-strip {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.4s var(--ease-out);
  }

  /* The spacing lives on the tab, inside the clipped wrapper, so the folded strip takes no space at all. */
  .widget-strip > div {
    min-height: 0;
    overflow: hidden;
  }

  .widget-tab {
    display: flex;
    align-items: center;
    gap: calc(6 * var(--dp));
    width: fit-content;
    height: calc(26 * var(--dp));
    margin: calc(6 * var(--dp)) calc(2 * var(--dp));
    padding: 0 calc(10 * var(--dp));
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--muted);
    font-size: calc(12.5 * var(--dp));
    font-weight: 600;
    transition:
      opacity 0.4s ease,
      transform 0.4s var(--ease-out);
  }

  .widget-tab :global(svg) {
    width: calc(13 * var(--dp));
    height: calc(13 * var(--dp));
  }

  .dot {
    width: calc(6 * var(--dp));
    height: calc(6 * var(--dp));
    border-radius: 50%;
    background: var(--warning);
  }

  /* As the app's field: at least 30dp tall under 12dp of padding, its line centred, so the placeholder and a typed
     line sit in the same place. */
  .field {
    display: flex;
    align-items: center;
    min-height: calc(42 * var(--dp));
    padding: calc(12 * var(--dp)) calc(6 * var(--dp)) 0;
    font-size: calc(15 * var(--dp));
    line-height: calc(24 * var(--dp));
  }

  .placeholder {
    color: var(--muted);
  }

  .typed:not(:empty) ~ .placeholder {
    display: none;
  }

  .caret {
    display: none;
    width: 1.5px;
    height: 1.1em;
    margin-left: 1px;
    vertical-align: text-bottom;
    background: var(--accent);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: calc(8 * var(--dp));
    margin-top: calc(8 * var(--dp));
    font-size: calc(13 * var(--dp));
    font-weight: 600;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: calc(5 * var(--dp));
    height: calc(32 * var(--dp));
    padding: 0 calc(12 * var(--dp));
    border-radius: 999px;
    background: var(--surface-2);
    white-space: nowrap;
  }

  .chip :global(svg) {
    width: calc(14 * var(--dp));
    height: calc(14 * var(--dp));
  }

  .round-chip {
    justify-content: center;
    width: calc(32 * var(--dp));
    padding: 0;
  }

  .round-chip :global(svg) {
    width: calc(16 * var(--dp));
    height: calc(16 * var(--dp));
  }

  .spacer {
    flex: 1;
  }

  .context {
    width: calc(20 * var(--dp));
    height: calc(20 * var(--dp));
    color: var(--muted);
  }

  .context-used {
    stroke-dasharray: var(--context, 9) 100;
    transition: stroke-dasharray 0.6s var(--ease-out);
  }

  /* Send in the accent; Stop, while the run works, in the text color. */
  .send {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    width: calc(40 * var(--dp));
    height: calc(40 * var(--dp));
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-fg);
    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }

  .send > :global(svg) {
    grid-area: 1 / 1;
    width: calc(16 * var(--dp));
    height: calc(16 * var(--dp));
    transition: opacity 0.2s ease;
  }

  .send > :global(.send-stop) {
    opacity: 0;
  }

  .gesture {
    width: 34%;
    height: calc(4 * var(--dp));
    margin: calc(12 * var(--dp)) auto calc(8 * var(--dp));
    border-radius: 99px;
    background: var(--fg);
    opacity: 0.5;
  }

  .notification {
    position: absolute;
    z-index: 2;
    top: calc(8 * var(--dp));
    left: calc(10 * var(--dp));
    right: calc(10 * var(--dp));
    display: flex;
    gap: calc(10 * var(--dp));
    padding: calc(12 * var(--dp)) calc(14 * var(--dp));
    border-radius: calc(22 * var(--dp));
    background: var(--surface-2);
    box-shadow: 0 calc(10 * var(--dp)) calc(30 * var(--dp)) rgb(0 0 0 / 0.3);
    opacity: 0;
    transform: translateY(-120%);
    transition:
      transform 0.55s var(--ease-out),
      opacity 0.35s ease;
  }

  .notification-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: calc(26 * var(--dp));
    height: calc(26 * var(--dp));
    border-radius: 50%;
    background: var(--accent-soft);
  }

  .notification-icon :global(svg) {
    width: calc(18 * var(--dp));
    height: calc(18 * var(--dp));
  }

  .notification-body {
    min-width: 0;
    line-height: 1.35;
  }

  .notification-head {
    color: var(--muted);
    font-size: calc(11.5 * var(--dp));
  }

  .notification-title {
    overflow: hidden;
    font-size: calc(13.5 * var(--dp));
    font-weight: 700;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .notification-text {
    color: var(--muted);
    font-size: calc(13 * var(--dp));
  }

  /* The static, finished chat is the default: the fold says Done and lists every step. Once the script takes over it
     adds .playing and drives the parts. */
  .phone:not(.playing) .empty,
  .phone:not(.playing) .title-new {
    opacity: 0;
  }

  .phone:not(.playing) .title-chat {
    opacity: 1;
  }

  .playing .step:not(.on),
  .playing .tool:not(.on) {
    grid-template-rows: 0fr;
    opacity: 0;
  }

  .playing .empty.off {
    opacity: 0;
    transform: translateY(calc(-12 * var(--dp))) scale(0.96);
  }

  .playing .widget-strip:not(.on) {
    grid-template-rows: 0fr;
  }

  .playing .widget-strip:not(.on) .widget-tab {
    opacity: 0;
    transform: translateY(100%);
  }

  .playing.typing .caret {
    display: inline-block;
    animation: blink 1s steps(1) infinite;
  }

  .playing:not(.typing):not(.sent) .send {
    background: color-mix(in srgb, var(--accent) 45%, var(--surface-1));
  }

  .playing.sent .title-new {
    opacity: 0;
  }

  .playing.sent .title-chat {
    opacity: 1;
  }

  .playing.busy .send {
    background: var(--fg);
    color: var(--page);
  }

  .playing.busy .send > :global(.send-arrow) {
    opacity: 0;
  }

  .playing.busy .send > :global(.send-stop) {
    opacity: 1;
  }

  .playing.busy .run-mark {
    display: grid;
  }

  .playing:not(.sent) .run {
    opacity: 0;
  }

  /* A reply's copy button and time show once it's written. */
  .playing.busy .reply-meta {
    opacity: 0;
  }

  .notification.on {
    opacity: 1;
    transform: none;
  }

  .playing.fading .screen > :not(.status) {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
