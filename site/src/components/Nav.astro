---
import Logo from "./Logo.astro";
import ThemeSelect from "./ThemeSelect.astro";
import { GITHUB_URL } from "../site";
---

<header class="nav">
  <nav class="container nav-inner" aria-label="Main">
    <a class="brand" href="/" aria-label="Pipkin home">
      <span class="brand-tile"><Logo size={24} /></span>
      <span>Pipkin</span>
    </a>
    <div class="links">
      <a class="hide-small" href="#features">Features</a>
      <a class="hide-small" href="#faq">FAQ</a>
      <a href="/docs/">Docs</a>
      <a class="github" href={GITHUB_URL} rel="noopener">
        <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"
          ></path>
        </svg>
        <span>GitHub</span>
      </a>
      <ThemeSelect />
    </div>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    background: color-mix(in srgb, var(--page) 78%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    transition: border-color 0.3s ease;
  }

  /* A hairline appears once the page has scrolled, using a scroll-driven animation where supported. */
  @supports (animation-timeline: scroll()) {
    .nav {
      animation: nav-edge linear both;
      animation-timeline: scroll();
      animation-range: 0 64px;
    }
  }

  @keyframes nav-edge {
    to {
      border-bottom-color: var(--border);
    }
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand-tile {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--cream);
    box-shadow: inset 0 0 0 1px light-dark(#ecdcc2, transparent);
  }

  .links {
    display: flex;
    align-items: center;
    gap: clamp(14px, 3vw, 28px);
    font-size: 15px;
  }

  .links a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .links a:hover {
    color: var(--fg);
  }

  .links .github {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--fg);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .links .github:hover {
    background: var(--surface-2);
  }

  @media (max-width: 560px) {
    .hide-small {
      display: none;
    }
  }

  /* Room for the theme menu on narrow phones: the GitHub link keeps only its icon, and its name as a label. */
  @media (max-width: 400px) {
    .links .github {
      padding: 8px;
    }

    .links .github span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
