---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  class?: string;
}

const { src, alt, sizes = "(max-width: 720px) 90vw, 400px", class: className } = Astro.props;
---

<figure class:list={["shot", className]}>
  <Picture
    src={src}
    alt={alt}
    formats={["avif"]}
    fallbackFormat="webp"
    widths={[360, 540, 720, 1080].filter((width) => width <= src.width)}
    sizes={sizes}
    loading="lazy"
    decoding="async"
  />
</figure>

<style>
  .shot {
    margin: 0;
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--app-bg);
    box-shadow: 0 30px 60px -36px rgb(0 0 0 / 0.5);
  }
</style>
