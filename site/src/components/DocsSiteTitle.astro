---
// Replaces Starlight's SiteTitle, whose logo is an image and so can't follow the theme, with the landing page's
// launcher tile. The markup and layout rules are adapted from Starlight 0.42.6's components/SiteTitle.astro
// (https://github.com/withastro/starlight, MIT License, Copyright (c) 2023 Astro contributors), since an override
// doesn't keep the original's styles.
import LauncherTile from "./LauncherTile.astro";
import LogoDefs from "./LogoDefs.astro";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<LogoDefs />
<a href={siteTitleHref} class="site-title sl-flex">
  <LauncherTile size={32} />
  <span translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: var(--sl-nav-gap);
    font-size: var(--sl-text-h4);
    color: var(--sl-color-text-accent);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }

  span {
    overflow: hidden;
  }
</style>
