---
import Icon, { type IconName } from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import Nav from "../components/Nav.astro";
import PhoneDemo from "../components/PhoneDemo.astro";
import Screenshot from "../components/Screenshot.astro";
import Base from "../layouts/Base.astro";
import { GITHUB_URL, PI_URL, TERMUX_URL } from "../site";

import extensionSelect from "../assets/screens/extension-select.png";
import fileView from "../assets/screens/file-view.png";
import gitChanges from "../assets/screens/git-changes.png";
import photos from "../assets/screens/photos.png";
import todoWidget from "../assets/screens/todo-widget.png";

const title = "Pipkin: a coding agent that lives on your Android phone";
const description =
  "Pipkin is a native Android app for agentic coding. Built on the Pi harness and powered by Termux, it reads your code, runs commands, edits files, and checks its work, all on your phone.";

const extras: { icon: IconName; title: string; text: string }[] = [
  {
    icon: "circle_check",
    title: "Guided setup",
    text: "Ready in minutes. A step-by-step guide sets up Termux and installs Pi for you, explaining each permission.",
  },
  {
    icon: "columns_2",
    title: "Optimized for all screens",
    text: "On foldables and tablets, split panes put chats, files, diffs, and terminals side by side.",
  },
  {
    icon: "bell",
    title: "Runs in the background",
    text: "Lock your phone or switch apps. A notification tells you when the chat is done.",
  },
  {
    icon: "key_round",
    title: "Your model, your plan",
    text: "Sign in with a Claude or OpenAI subscription, add a Gemini, Z.ai or Kimi key, or point Pipkin at any OpenAI-compatible API.",
  },
  {
    icon: "search",
    title: "Tailored extensions included for the best experience",
    text: "Pipkin comes with extensions tailored to it for the best experience.",
  },
  {
    icon: "refresh_cw",
    title: "Backups",
    text: "Save your settings, sign-ins, models, and extensions in one tap, and restore them when you need to.",
  },
];

const faqs: { question: string; answer: string; link?: { href: string; text: string } }[] = [
  {
    question: "What is an AI coding agent?",
    answer:
      "It's an assistant that does the work instead of only suggesting it. You describe a goal, and the agent reads your files, runs commands, makes changes, and checks the result, step by step, while you watch and steer.",
  },
  {
    question: "Do I need a computer?",
    answer:
      "No. The agent, your files, git, and a terminal all run on your phone. Pipkin was built so a phone can be your only development machine.",
  },
  {
    question: "Which AI models can I use?",
    answer:
      "Sign in with a Claude or OpenAI subscription, add a Gemini, Z.ai Coding Plan or Kimi Code API key, or add any API that speaks the OpenAI format, including hosted gateways and servers you run yourself. You can add several and switch per chat.",
  },
  {
    question: "Does the AI model run on my phone?",
    answer:
      "The agent and every command it runs are on your phone. The model's thinking happens at the provider you connect, so you need a network connection while a chat is working. Local LLM support is on the roadmap though!",
  },
  {
    question: "Which phones does Pipkin support?",
    answer: "Phones running Android 10 or newer. Pipkin also adapts to tablets and foldables.",
  },
  {
    question: "Is Pipkin open source?",
    answer: "Yes. Pipkin is open source under the MIT license.",
    link: { href: GITHUB_URL, text: "View the source on GitHub." },
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Pipkin",
    description,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Android 10 or later",
    softwareRequirements: "Termux",
    url: new URL("/", Astro.site).href,
    image: new URL("/og.png", Astro.site).href,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(({ question, answer }) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
];
---

<Base title={title} description={description} structuredData={structuredData}>
  <Nav />

  <main>
    <section class="hero container">
      <div class="hero-copy">
        <p class="eyebrow intro" style="--i: 0">
          <span class="pulse" aria-hidden="true"></span>
          Agentic coding for Android
        </p>
        <h1 class="intro" style="--i: 1">An agent native to your phone.</h1>
        <p class="lede intro" style="--i: 2">
          Pipkin is a native Android AI agent. Tell it what to build or fix, and it reads your code, runs commands, edits
          files, and checks its own work, all on your phone. No remotely running computer required.
        </p>
        <div class="actions intro" style="--i: 3">
          <a class="button button-primary" href={GITHUB_URL} rel="noopener">View on GitHub</a>
          <a class="button button-quiet" href="#features">See what it does</a>
        </div>
      </div>
      <div class="hero-demo intro" style="--i: 2">
        <div class="glow" aria-hidden="true"></div>
        <PhoneDemo />
      </div>
    </section>

    <div id="features">
      <section class="feature container" id="on-device" aria-labelledby="on-device-title">
        <div class="feature-copy" data-reveal>
          <p class="eyebrow">No Computer Required</p>
          <h2 id="on-device-title">Just your Android device.</h2>
          <p>
            Most agents you use from a phone are remotes. The real work happens on a laptop or cloud server
            somewhere else. Pipkin runs directly on your phone, so your code, your tools, and every command run in your
            pocket. There's no other machine to set up, pay for, or keep awake.
          </p>
          <p>
            Pipkin is powered by <a href={TERMUX_URL} rel="noopener">Termux</a>, a Linux-like environment for Android. It
            allows Pipkin to run programs just like on a desktop or server. Thousands of programs, from compilers to
            databases, install natively with <code>pkg</code>. For everything else,
            <code>proot-distro</code> simulates Debian or Ubuntu, no root required.
          </p>
        </div>
        <div class="feature-media" data-reveal style="--reveal-delay: 0.1s">
          <div class="terminal" role="img" aria-label="A terminal installing Python, Node.js, Rust, and git with pkg, then logging in to Debian with proot-distro">
            <div class="terminal-bar" aria-hidden="true">
              <Icon name="square_terminal" size={16} />
              <em>Terminal 1 · ~/projects</em>
            </div>
            <pre aria-hidden="true"><code><span class="prompt">~/projects $</span> pkg install python nodejs rust git
<span class="dim">Setting up python ...
Setting up nodejs ...
Setting up rust ...
Setting up git ...</span>
<span class="prompt">~/projects $</span> proot-distro install debian
<span class="prompt">~/projects $</span> proot-distro login debian
<span class="root">root@localhost:~#</span> apt install <span class="accent">anything-else</span><span class="cursor"></span></code></pre>
          </div>
        </div>
      </section>

      <section class="feature container flip" id="pi" aria-labelledby="pi-title">
        <div class="feature-copy" data-reveal>
          <p class="eyebrow">Powered by Pi</p>
          <h2 id="pi-title">Vast ecosystem included</h2>
          <p>
            Pipkin is built on <a href={PI_URL} rel="noopener">Pi</a>, the open-source agentic harness, and compatible
            with Pi's ecosystem of skills, tools, prompt templates, and extensions.
          </p>
          <p>
            Extensions render beautifully and natively in Pipkin's UI using native controls and displays. Questions,
            statuses, and widgets feel like a part of the app.
          </p>
          <ul class="checks">
            <li>Install extensions the usual Pi way and Pipkin picks them up</li>
            <li>Choices, confirmations, and text fields appear as cards above the composer</li>
            <li>Status lines, notices, and widgets, like the bundled to-do list, each get a home</li>
          </ul>
        </div>
        <div class="feature-media stacked-media" data-reveal style="--reveal-delay: 0.1s; --overlap: 12px">
          <Screenshot
            src={extensionSelect}
            alt="A Pi extension asking where a build should go, shown as a native card with radio buttons and a Submit button"
          />
          <Screenshot
            class="stacked-front"
            src={todoWidget}
            alt="The bundled to-do extension's widget, showing three finished tasks above the composer"
            sizes="(max-width: 720px) 70vw, 300px"
          />
          <p class="media-caption">
            Extensions need to support Pi's RPC UI protocol to render natively.
          </p>
        </div>
      </section>

      <section class="feature container" id="android" aria-labelledby="android-title">
        <div class="feature-copy" data-reveal>
          <p class="eyebrow">Android Native</p>
          <h2 id="android-title">Made for Android. Not shrunk down to fit.</h2>
          <p>
            Pipkin is written using Android's own UI toolkit. There's no web view or JavaScript rendering, so scrolling,
            typing, and streaming replies stay smooth, even in long chats.
          </p>
          <p>
            Work continues in your pocket. Pipkin notifies you when it's done. On a foldable or tablet, split screen lets
            you see things side by side.
          </p>
        </div>
        <div class="feature-media captioned-media" data-reveal style="--reveal-delay: 0.1s">
          <Screenshot
            src={fileView}
            alt="A Python file open in Pipkin's file viewer with syntax highlighting and line numbers"
          />
          <p class="media-caption">
            Code gets real syntax highlighting for more than twenty languages, from Python and TypeScript to Rust,
            Kotlin, and Dockerfiles.
          </p>
        </div>
      </section>

      <section class="feature container flip" id="real-work" aria-labelledby="real-title">
        <div class="feature-copy" data-reveal>
          <p class="eyebrow">A real tool</p>
          <h2 id="real-title">Built for serious work. Handy for the small stuff.</h2>
          <p>
            Pipkin is made for real software projects: real repositories, real toolchains, real test suites. Review
            every change in the built-in diff viewer, browse and edit files, and look back through your commits without
            leaving the app.
          </p>
          <p>
            Because the agent can reach your phone's storage, it's just as good at everyday chores. Ask it to find
            duplicate photos, sort downloads into folders, or clear out pictures you don't want, then check its work
            before anything is deleted.
          </p>
        </div>
        <div class="feature-media stacked-media" data-reveal style="--reveal-delay: 0.1s">
          <Screenshot
            src={gitChanges}
            alt="Pipkin's Changes view showing uncommitted git changes across three files, with added lines highlighted"
          />
          <Screenshot
            class="stacked-front"
            src={photos}
            alt="Pipkin's reply after finding duplicate photos in the Camera folder and moving the extra copies to a Duplicates folder for review"
            sizes="(max-width: 720px) 70vw, 320px"
          />
        </div>
      </section>
    </div>

    <section class="extras container" id="more" aria-labelledby="more-title">
      <div class="extras-head" data-reveal>
        <p class="eyebrow">And more</p>
        <h2 id="more-title">The details other harnesses skip.</h2>
      </div>
      <ul class="extras-grid">
        {
          extras.map((extra, index) => (
            <li data-reveal style={`--reveal-delay: ${(index % 3) * 0.06}s`}>
              <span class="extra-icon">
                <Icon name={extra.icon} size={20} />
              </span>
              <h3>{extra.title}</h3>
              <p>{extra.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="faq container" id="faq" aria-labelledby="faq-title">
      <div class="faq-head" data-reveal>
        <p class="eyebrow">Questions</p>
        <h2 id="faq-title">Frequently Asked</h2>
      </div>
      <div class="faq-list" data-reveal data-faq>
        {
          faqs.map((faq) => (
            <details name="faq">
              <summary>
                {faq.question}
                <Icon name="plus" size={18} />
              </summary>
              <div class="faq-answer">
                <p>
                  {faq.answer}
                  {faq.link && (
                    <>
                      {" "}
                      <a href={faq.link.href} rel="noopener">
                        {faq.link.text}
                      </a>
                    </>
                  )}
                </p>
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <section class="closing container" aria-labelledby="closing-title" data-reveal>
      <span class="closing-mark"><Logo size={56} simmer /></span>
      <h2 id="closing-title">Your next project fits in your pocket.</h2>
      <a class="button button-primary" href={GITHUB_URL} rel="noopener">View on GitHub</a>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <a class="footer-brand" href="/">
        <Logo size={20} />
        Pipkin
      </a>
      <nav class="footer-links" aria-label="Footer">
        <a href="/docs/">Docs</a>
        <a href={GITHUB_URL} rel="noopener">GitHub</a>
        <a href={PI_URL} rel="noopener">Pi</a>
        <a href={TERMUX_URL} rel="noopener">Termux</a>
      </nav>
      <p class="footer-note">An agent native to your phone. © 2026 Pipkin</p>
    </div>
  </footer>
</Base>

<script>
  import { animateFaq } from "../scripts/faq";

  const faqList = document.querySelector<HTMLElement>("[data-faq]");
  if (faqList) animateFaq(faqList);
</script>

<style>
  main {
    overflow-x: clip;
  }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(32px, 6vw, 72px);
    padding-top: clamp(40px, 7vw, 88px);
    padding-bottom: clamp(56px, 8vw, 104px);
  }

  .hero h1 {
    margin-top: 18px;
    font-size: clamp(38px, 5.6vw, 64px);
  }

  .lede {
    max-width: 34em;
    margin-top: 22px;
    color: var(--muted);
    font-size: clamp(17px, 1.6vw, 19px);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .pulse {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .hero-demo {
    position: relative;
    display: grid;
    place-items: center;
  }

  .glow {
    position: absolute;
    inset: 8% -10%;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 26%, transparent), transparent);
    filter: blur(30px);
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: no-preference) {
    .intro {
      animation: intro 0.9s var(--ease-out) both;
      animation-delay: calc(var(--i) * 0.08s + 0.05s);
    }

    .pulse::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--accent);
      animation: pulse 2.4s ease-out infinite;
    }
  }

  @keyframes intro {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @keyframes pulse {
    from {
      opacity: 0.6;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(3);
    }
  }

  /* Feature sections */
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(36px, 7vw, 96px);
    padding-block: clamp(56px, 8vw, 104px);
    border-top: 1px solid var(--border);
  }

  .feature.flip .feature-copy {
    order: 2;
  }

  .feature h2 {
    margin-top: 14px;
    font-size: clamp(28px, 3.4vw, 40px);
  }

  .feature-copy > p:not(.eyebrow) {
    margin-top: 18px;
    color: var(--muted);
  }

  .feature-copy a {
    color: var(--fg);
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }

  .feature-copy code {
    padding: 1px 6px;
    border-radius: 5px;
    background: var(--surface-2);
    color: var(--fg);
  }

  .feature-media {
    display: flex;
    justify-content: center;
  }

  .feature-media > :global(.shot) {
    width: min(440px, 100%);
  }

  .checks {
    display: grid;
    gap: 10px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .checks li {
    position: relative;
    padding-left: 28px;
    color: var(--fg);
    font-size: 16px;
  }

  .checks li::before {
    content: "";
    position: absolute;
    top: 0.45em;
    left: 2px;
    width: 12px;
    height: 7px;
    border-bottom: 2px solid var(--success);
    border-left: 2px solid var(--success);
    transform: rotate(-45deg);
  }

  /* Two screenshots, the second overlapping the first's lower corner. */
  .stacked-media {
    flex-direction: column;
    align-items: flex-start;
  }

  .stacked-media > :global(.shot:not(.stacked-front)) {
    width: min(400px, 88%);
  }

  .stacked-media > :global(.stacked-front) {
    margin: calc(-1 * var(--overlap, 120px)) 0 0 auto;
  }

  .captioned-media {
    flex-direction: column;
    align-items: center;
  }

  .captioned-media > .media-caption {
    width: min(440px, 100%);
  }

  .media-caption {
    margin-top: 14px;
    color: var(--muted);
    font-size: 14px;
  }

  /* Terminal */
  .terminal {
    width: min(480px, 100%);
    overflow: hidden;
    border: 1px solid #2f3534;
    border-radius: var(--radius-lg);
    background: #181b1a;
    color: #fafafa;
    box-shadow: 0 30px 60px -36px rgb(0 0 0 / 0.55);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 16px;
    border-bottom: 1px solid #252b2a;
  }

  .terminal-bar :global(svg) {
    color: #a1a5a4;
  }

  .terminal-bar em {
    margin-left: 10px;
    color: #a1a5a4;
    font-family: var(--mono);
    font-size: 12px;
    font-style: normal;
  }

  .terminal pre {
    margin: 0;
    padding: 18px 20px 22px;
    overflow-x: auto;
    font-size: 13.5px;
    line-height: 1.7;
  }

  .terminal code {
    font-size: inherit;
  }

  .prompt {
    color: #b5bd68;
  }

  .root {
    color: #f7796d;
  }

  .dim {
    color: #717574;
  }

  .accent {
    color: #dd774e;
  }

  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: #fafafa;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: blink 1.1s steps(1) infinite;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* Extras */
  .extras {
    padding-block: clamp(64px, 9vw, 112px);
    border-top: 1px solid var(--border);
  }

  .extras h2,
  .faq h2 {
    margin-top: 14px;
    font-size: clamp(28px, 3.4vw, 40px);
  }

  .extras-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }

  .extras-grid li {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    transition:
      border-color 0.25s ease,
      transform 0.35s var(--ease-out);
  }

  .extras-grid li:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .extra-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .extras-grid h3 {
    margin: 16px 0 6px;
    font-size: 18px;
  }

  .extras-grid p {
    color: var(--muted);
    font-size: 15.5px;
  }

  /* FAQ */
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 80px);
    padding-block: clamp(64px, 9vw, 112px);
    border-top: 1px solid var(--border);
  }

  .faq-list {
    border-top: 1px solid var(--border);
  }

  details {
    border-bottom: 1px solid var(--border);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    font-size: 17px;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary :global(svg) {
    flex: none;
    color: var(--muted);
    transition: transform 0.3s var(--ease-out);
  }

  /* The script marks a closing answer before its height animation ends, so the icon turns back right away. */
  details[open]:not([data-state="closed"]) summary :global(svg) {
    transform: rotate(45deg);
  }

  .faq-answer {
    overflow: hidden;
  }

  .faq-answer p {
    padding: 0 0 22px;
    color: var(--muted);
  }

  /* Closing */
  .closing {
    display: grid;
    justify-items: center;
    gap: 18px;
    padding-block: clamp(72px, 10vw, 128px);
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .closing-mark {
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    border-radius: 26px;
    background: var(--cream);
  }

  .closing h2 {
    font-size: clamp(30px, 4vw, 46px);
  }

  /* Footer */
  .footer {
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding-block: 28px;
    color: var(--muted);
    font-size: 14px;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--fg);
    font-family: var(--mono);
    font-weight: 700;
    text-decoration: none;
  }

  .footer-links {
    display: flex;
    gap: 22px;
  }

  .footer-links a {
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--fg);
  }

  .footer-note {
    width: 100%;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .hero,
    .feature,
    .faq {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero {
      text-align: center;
    }

    .lede {
      margin-inline: auto;
    }

    .actions {
      justify-content: center;
    }

    .feature.flip .feature-copy {
      order: 0;
    }

    .extras-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .extras-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
