<?xml version="1.0" encoding="utf-8"?>
<!-- Local models run in Pipkin's :inference process and answer plain HTTP on loopback, which never leaves the phone.
     Everything else keeps Android's default, which refuses cleartext. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
