    <string name="settings_update_extensions_running">Updating Pi extensions…</string>
    <string name="settings_update_extensions_title">Update Pi extensions?</string>
    <string name="settings_update_extensions_text">Pi updates every package installed in its settings to the latest version, except packages pinned to a version. Chats can\'t start until the update finishes. Afterwards, idle chats reload with the new versions, and working chats pick them up when they next start.</string>
