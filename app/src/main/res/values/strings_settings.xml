    <string name="settings_running_agents">Running agents</string>
    <string name="settings_running_agents_summary">How many run at once, and when idle ones stop</string>
    <string name="settings_running_chats">Running chats</string>
    <string name="settings_running_chats_fewer">Fewer running chats</string>
    <string name="settings_running_chats_more">More running chats</string>
    <plurals name="settings_running_chats_caption">
        <item quantity="one">How many chats can keep their agent running at once. Each one runs a few processes in Termux, more while it works. Android stops apps\' processes once there are more than 32 in all, so with more than %1$d chat running, any of them may be stopped mid-run unless Disable child process restrictions is on in Developer options (Android 14 and later).</item>
        <item quantity="other">How many chats can keep their agent running at once. Each one runs a few processes in Termux, more while it works. Android stops apps\' processes once there are more than 32 in all, so with more than %1$d chats running, any of them may be stopped mid-run unless Disable child process restrictions is on in Developer options (Android 14 and later).</item>
    </plurals>
    <string name="settings_idle_stop">Stop idle chats after</string>
    <string name="settings_idle_stop_1_minute">1 minute</string>
    <string name="settings_idle_stop_5_minutes">5 minutes</string>
    <string name="settings_idle_stop_15_minutes">15 minutes</string>
    <string name="settings_idle_stop_30_minutes">30 minutes</string>
    <string name="settings_idle_stop_never">Never</string>
    <string name="settings_idle_stop_caption">A chat that isn\'t working, running background tasks, or on screen stops its agent after this long to free memory. Its history stays, and the agent starts again when you open it. With Never, a chat stops only when another needs its place.</string>

