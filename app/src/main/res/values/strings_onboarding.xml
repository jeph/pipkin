    <string name="onboarding_welcome_title">Welcome to Pipkin</string>
    <string name="onboarding_welcome_body">A coding agent that runs on your phone. Setup takes a few minutes, and most of it happens on its own.</string>
    <string name="onboarding_get_started">Get started</string>

    <string name="onboarding_done_title">You\'re all set</string>
    <string name="onboarding_done_body">Open a folder from the sidebar to start your first chat.</string>
    <string name="onboarding_done_body_no_model">Connect a model in Settings → Providers before your first chat.</string>
    <string name="onboarding_start">Start using Pipkin</string>

    <string name="onboarding_termux_title">Termux</string>
    <string name="onboarding_termux_install_title">Install Termux</string>
    <string name="onboarding_termux_replace_title">Replace Termux</string>
    <string name="onboarding_termux_update_title">Update Termux</string>
    <string name="onboarding_termux_missing">Pipkin\'s agent runs inside Termux, a terminal app for Android. Get it from F-Droid or Google Play, then come back. We recommend the F-Droid version for the best user experience.</string>
    <string name="onboarding_termux_missing_fdroid_only">Pipkin\'s agent runs inside Termux, a terminal app for Android. Get it from F-Droid, then come back.</string>
    <string name="onboarding_termux_get_fdroid">Get it on F-Droid</string>
    <string name="onboarding_termux_get_play">Get it on Google Play</string>
    <string name="onboarding_termux_unsupported">This copy of Termux isn\'t from F-Droid or Google Play, so Pipkin won\'t use it. Uninstalling it deletes Termux\'s files.</string>
    <string name="onboarding_termux_security">Pipkin only supports signed F-Droid and Google Play versions of Termux for your safety.</string>
    <string name="onboarding_termux_uninstall">Uninstall Termux</string>
    <string name="onboarding_termux_too_old_fdroid">Pipkin needs Termux 0.118 or newer.</string>
    <string name="onboarding_termux_update_fdroid">Update on F-Droid</string>
    <string name="onboarding_termux_too_old_play">This Termux is older than Pipkin supports.</string>
    <string name="onboarding_termux_update_play">Update on Google Play</string>
    <string name="onboarding_termux_ready_fdroid">Termux %1$s from F-Droid is installed.</string>
    <string name="onboarding_termux_ready_play">Termux %1$s from Google Play is installed.</string>

    <string name="onboarding_run_command_title">Let Pipkin use Termux</string>
    <string name="onboarding_run_command_body">Pipkin starts by sending commands to Termux.</string>
    <string name="onboarding_run_command_blocked">Android won\'t ask again. In settings, open Permissions, then Additional permissions if it\'s there, and allow \"Run commands in Termux environment\".</string>
    <string name="onboarding_run_command_done">Pipkin can run commands in Termux.</string>

    <string name="onboarding_setup_title">Set up Termux</string>
    <string name="onboarding_setup_body">Paste the setup command into Termux. Also allow storage access if asked.</string>
    <string name="onboarding_setup_retry_note">Android may sometimes kill large pkg installs during setup. If this happens, please retry the command. It picks up where it left off.</string>
    <string name="onboarding_setup_waiting">Waiting for Termux to finish…</string>
    <string name="onboarding_setup_connecting">Connecting to Termux…</string>
    <string name="onboarding_setup_changed">Termux was reinstalled, which removed Pipkin\'s setup, the agent and its sign-in. Paste the command again.</string>
    <string name="onboarding_setup_action">Copy command &amp; open Termux</string>
    <string name="onboarding_setup_done">Termux is ready for Pipkin.</string>
