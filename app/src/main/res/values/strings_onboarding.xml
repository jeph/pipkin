    <string name="onboarding_notifications_title">Notifications</string>
    <string name="onboarding_notifications_body">Pipkin tells you when a chat finishes while you\'re away, and shows a Stop button while the agent works.</string>
    <string name="onboarding_notifications_done">Notifications are on.</string>

    <string name="onboarding_background_title">Run in the background</string>
    <string name="onboarding_background_body">Keeps a chat going while the screen is off or you\'re in another app. Without it, Android can cut the agent off mid-task.</string>
    <string name="onboarding_background_done">Pipkin can run in the background.</string>

    <string name="onboarding_termux_background_title">Let Termux run in the background</string>
    <string name="onboarding_termux_background_body">Keeps Pipkin\'s helper in Termux running, so Pipkin starts without opening Termux. In Termux\'s app info, open App battery usage and choose Unrestricted.</string>
    <string name="onboarding_termux_background_allow">Open Termux\'s app info</string>
    <string name="onboarding_termux_background_done">Termux can run in the background.</string>

