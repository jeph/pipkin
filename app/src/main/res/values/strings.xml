<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="app_name" translatable="false">Pipkin</string>

    <string name="agent_notification_channel">Agent activity</string>
    <string name="agent_notification_title">Pipkin agent is working</string>
    <string name="agent_notification_text">Running in Termux. Progress continues if you leave the app.</string>
    <string name="agent_notification_stop">Stop</string>
    <string name="agent_notification_background_title">A background task is running</string>
    <string name="agent_notification_background_text">Running in Termux. The agent picks up its result, even if you leave the app.</string>
    <string name="agent_notification_terminal_title">A terminal command is running</string>
    <string name="agent_notification_terminal_text">Running in Termux. It continues if you leave the app.</string>

    <string name="turn_notification_channel">Finished chats</string>
    <string name="turn_notification_finished">Agent finished</string>
    <string name="turn_notification_failed">Agent failed</string>
    <string name="turn_notification_exited">Pi exited</string>

    <string name="dialog_notification_channel">Questions from chats</string>
    <string name="dialog_notification_waiting">Agent needs your answer</string>
    <!-- dialog_notification_waiting when Pipkin can tell which of the chat's subagents asked; %1$s is its agent's
         name, such as Explore. -->
    <string name="dialog_notification_waiting_subagent">%1$s needs your answer</string>
    <string name="dialog_notification_text">Open the chat to answer.</string>

    <!-- A chat notification's headline, such as Agent finished, then the chat's title. -->
    <string name="chat_notification_title">%1$s: %2$s</string>

    <!-- Shown over every screen while Pipkin waits for its helper in Termux's Google Play build. -->
    <string name="termux_waking">Starting Pipkin\'s helper in Termux…</string>

    <!-- Why a request to the agent failed. %1$s is the agent's command name, such as get_state, kept as is. -->
    <string name="agent_rpc_rejected">The agent rejected <xliff:g id="command" example="set_model">%1$s</xliff:g>.</string>
    <string name="agent_rpc_timed_out">The agent did not answer <xliff:g id="command" example="get_state">%1$s</xliff:g> in time.</string>
    <string name="agent_not_running">The agent is not running.</string>
    <string name="agent_install_failed">Installing the Pipkin agent failed.</string>

    <!--
        Why another chat can't open: the chats already running are all busy. Built from two sentences, a count of busy
        chats (agent_too_many_working or agent_too_many_shown) and advice (agent_too_many_over_limit or
        agent_too_many_stop_one), joined by agent_too_many.
    -->
    <string name="agent_too_many">%1$s %2$s</string>
    <plurals name="agent_too_many_working">
        <item quantity="one"><xliff:g id="count" example="1">%1$d</xliff:g> chat is working.</item>
        <item quantity="other"><xliff:g id="count" example="4">%1$d</xliff:g> chats are working.</item>
    </plurals>
    <!-- Like agent_too_many_working, for when an idle chat shown on screen also holds its agent. -->
    <plurals name="agent_too_many_shown">
        <item quantity="one"><xliff:g id="count" example="1">%1$d</xliff:g> chat is working or on screen.</item>
        <item quantity="other"><xliff:g id="count" example="4">%1$d</xliff:g> chats are working or on screen.</item>
    </plurals>
    <!-- After the limit of running chats in Settings was lowered below the number already running. -->
    <plurals name="agent_too_many_over_limit">
        <item quantity="one">That\'s more than the limit of <xliff:g id="limit" example="1">%1$d</xliff:g>, so stop some to open another.</item>
        <item quantity="other">That\'s more than the limit of <xliff:g id="limit" example="2">%1$d</xliff:g>, so stop some to open another.</item>
    </plurals>
    <string name="agent_too_many_stop_one">Stop one to open another.</string>

    <!-- Joins short facts in one line, such as a project and a model in a notification. Keep the spaces. -->
    <string name="separator_dot">"\u0020·\u0020"</string>
</resources>
